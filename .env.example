# 服务监听配置
HOST=127.0.0.1
PORT=3000

# 可选：若需要单独再开一个仅提供监控后台的端口，可取消注释
# MONITOR_PORT=3002

# 监控后台访问密码（留空则本地免密访问，部署公网时强烈建议设置）
MONITOR_PASSWORD=

# 可选：访问根路径 "/" 时自动跳转到指定测试（填 quizzes/ 下的 slug，如 asti）；留空则展示测试导航页
DEFAULT_QUIZ=

# 可选：最大保留记录数（默认 1000）
MAX_RECORDS=1000

# 可选：存储驱动（auto | file | redis）。配置下方 Upstash Redis 变量后 auto 模式会自动启用云端 Redis
STORAGE_DRIVER=auto
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_KEY_PREFIX=watching
